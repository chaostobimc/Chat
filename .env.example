# Discord Ticket Bot - Environment Variables
# Copy this file to .env and fill in your values

# Discord Bot Token (Required)
DISCORD_TOKEN=your_discord_bot_token_here

# Admin User IDs (comma-separated)
# Only these users can use spawner commands (/spawner, /sendspawner, /updateprice, etc.)
# Example: ADMIN_USER_IDS=123456789,987654321,111222333
ADMIN_USER_IDS=

# Support Role IDs (comma-separated)
# Users with these roles can manage ALL tickets (close, claim, etc.)
# This applies to both normal tickets and spawner tickets
# Example: SUPPORT_ROLE_IDS=123456789,987654321
SUPPORT_ROLE_IDS=

# Dashboard Configuration
SECRET_KEY=your-secret-key-change-this-in-production
DASHBOARD_PASSWORD=admin
DASHBOARD_PORT=3000
